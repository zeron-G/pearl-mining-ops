# Public Pearl receive address or exchange PRL deposit address.
PEARL_ADDRESS=prl1p...

# Runtime defaults.
DEFAULT_POOL=pearlhash
WSL_DISTRO=Ubuntu
DRY_RUN=true

PEARLHASH_HOST=84.32.220.219:9000
ALPHAPOOL_POOL=stratum+tcp://us2.alphapool.tech:5566
MINER_WORKER=worker01
PEARLHASH_ENGINE=wildrig
PEARLHASH_URL=pool.pearlhash.xyz:9000
PEARL_TRIAL_TEMP=75
PEARL_TRIAL_SECONDS=28800
ALPHAPOOL_PASSWORD='x;d=1048576'

DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
TRUSTED_IP=

# SafeTrade API. Keep real values only in .env, never in git.
SAFETRADE_BASE_URL=https://safe.trade/api/v2
SAFETRADE_API_KEY=
SAFETRADE_API_SECRET=
SAFETRADE_PRL_MARKET=prlusdt

# Trading guards. Live trading requires both DRY_RUN=false and ALLOW_LIVE_TRADING=true.
ALLOW_LIVE_TRADING=false
MAX_PRL_SELL_PER_RUN=10
MIN_USDT_TO_WITHDRAW=25

# Withdrawal is intentionally disabled by default because SafeTrade's public example
# client documents authentication/orders but not a stable withdrawal endpoint.
ALLOW_WITHDRAWALS=false
SAFETRADE_WITHDRAW_ENDPOINT=
USDT_WITHDRAW_NETWORK=
USDT_WITHDRAW_ADDRESS=

# Optional Pearl CLI for self-custody wallet sends to a SafeTrade PRL deposit address.
ALLOW_WALLET_SENDS=false
PEARL_CLI_PATH=
SAFETRADE_PRL_DEPOSIT_ADDRESS=
PEARL_SEND_COMMAND_TEMPLATE=
